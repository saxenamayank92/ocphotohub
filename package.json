{
  "name": "club-photo-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "worker:dev": "wrangler dev worker/src/index.js",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "cap:sync": "npm run build && npx cap sync && node scripts/ensure-ios-firebase.mjs",
